[alias]
	br = branch
	bs = flow bugfix start --fetch
	ci = commit
	co = checkout
	db = ! git diff $(git merge-base main HEAD)..HEAD
	dd = diff develop..HEAD
	dm = diff main..HEAD
	dn = diff PreProd..HEAD
	dob = ! git branch -vv | grep ': gone]' | grep -v '\\*' | awk '{ print $1 }' | xargs -n 1 -r -p git branch -D
	dp = diff Prod..HEAD
	fs = flow feature start --fetch
	ff = flow feature finish
	hb = ! git hist $(git merge-base main HEAD)..HEAD
	hd = hist develop..HEAD
	hist = log --pretty=format:'%C(auto)%h %ad | %s%d [%an]' --graph --date=iso
	hm = hist main..HEAD
	hn = hist PreProd..HEAD
	hp = hist Prod..HEAD
	mb = merge-base main HEAD
	pf = push --force
	rib = ! git rebase --interactive $(git merge-base main HEAD)
	rid = rebase --interactive develop
	rim = rebase --interactive main
	rs = flow release start --fetch
	rf = flow release finish --push --noff-main
	st = status
[core]
	editor = code --wait
[user]
	email = edgars.didrihsons@gmail.com
	name = Edgars Didrihsons
[fetch]
	prune = true
[pull]
	default = simple
	rebase = true
[init]
	defaultBranch = main
